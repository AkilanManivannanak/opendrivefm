# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# macOS
.DS_Store

# Experiment / generated
# NOTE: `outputs/` alone cannot be selectively un-ignored. Git does not descend
# into an excluded DIRECTORY, so a later `!outputs/artifacts/x.json` is never
# even considered. The exclusion must be written per-entry so the directory
# itself stays traversable.
outputs/*
!outputs/artifacts/
outputs/artifacts/*
lightning_logs/

# Data
data/
dataset/

# Checkpoints / archives
*.ckpt
*.pt
*.pth
*.zip

# Build trees
# `scripts/build/` was listed but `cpp/` did not exist when this was written.
# A CMake build dir carries object files, compiled binaries, absolute paths from
# the machine that configured it, and a CMakeCache.txt that actively breaks a
# build on any other machine. It is generated output, never source.
scripts/build/
cpp/build/
**/CMakeFiles/
**/CMakeCache.txt
*.o
*.a
*.so
*.dylib

# Optional
.env
.Rhistory

# Editor/agent backups
*.bak
*.bak[0-9]*
*.bak.*

# Evidence for the README and the CI release gates.
#
# outputs/ is ignored above because it holds checkpoints, LiDAR manifests and a
# 350MB road_assets.json. But .github/workflows/validation.yml runs the release
# gates on "committed artifacts", and the README cites a JSON file for every
# number it reports. If those files are not in the repo, the gate job cannot run
# and no reader can check a single claim.
#
# So the small detection/validation reports are un-ignored deliberately. Keep
# this list explicit: never blanket-unignore outputs/artifacts/*.json, or the
# 350MB file lands in git history where it cannot be removed.
!outputs/artifacts/ood_detection_report*.json
!outputs/artifacts/batch_contamination*.json
!outputs/artifacts/conformal_trajectory.json
!outputs/artifacts/per_camera_fault_ranking.json
!outputs/artifacts/failure_triage_vlm.json

# Second backbone, 2026-10-29 (A62, A65-A67). Same rule as above: named
# entries only, never a wildcard over outputs/artifacts. The directory itself
# must be un-ignored first or git will not descend into it to see the files.
!outputs/artifacts/h2_max_test_flashocc_*.json
!outputs/artifacts/pod_2026_10_29/
!outputs/artifacts/pod_2026_10_29/*.json
!outputs/artifacts/pod_2026_10_29/*.md
!outputs/artifacts/pod_2026_10_29/*.log
!outputs/artifacts/pod_2026_10_29/*.log.gz

# Rendered figures are ignored wholesale (they can be regenerated and some are
# large). Portfolio figures are un-ignored one at a time, same discipline as
# outputs/artifacts above -- never blanket-unignore outputs/figures/.
!outputs/figures/
outputs/figures/*
!outputs/figures/bev_lidar_real.png
!outputs/figures/scene_view.png
!outputs/figures/scene_view_CAM_BACK.png
!outputs/artifacts/scene_view*.json
!outputs/artifacts/motion_separation_report.json
# A55: the deployability result is cited in the paper, so it is tracked.
!outputs/artifacts/a55_pred_occluder.json
!outputs/artifacts/a56_fullpx.json

# Paper deliverables. Both are regenerated by a script that reads
# outputs/artifacts/ at build time (scripts/viz/fig1_granularity.py and
# scripts/paper/table4_ledger.py), so they are small, deterministic, and
# cited by the manuscript -- which is exactly the class of file A40's lesson
# says must be in git rather than only on one laptop. Still an explicit
# allowlist: never blanket-unignore outputs/tables/.
!outputs/figures/fig0_hero.pdf
!outputs/figures/fig1_granularity.pdf
!outputs/figures/fig2_qualitative.pdf
!outputs/figures/fig3_whynotmask.pdf
!outputs/figures/fig5_deployability.pdf
!outputs/figures/fig6_quadrant.pdf
!outputs/tables/
outputs/tables/*
!outputs/tables/table4_ledger.tex
!outputs/tables/table1_perclass.tex
!outputs/tables/table4_ledger.txt
!outputs/figures/opendrivefm_summary.png
!outputs/artifacts/integrity_visibility_report.json
!outputs/artifacts/occupancy_forecast_report.json
!outputs/artifacts/timing_report.json
!outputs/artifacts/trajectory_ade_report.json

# The console bundle is ~7 MB of base64 frames regenerated by
# scripts/export_console_bundle.py; the builder is versioned, the render is not.
outputs/console/
!outputs/artifacts/learned_model_report.json
!outputs/artifacts/vla_report.json
!outputs/artifacts/vlm_report.json
!outputs/artifacts/robustness_report.json
!outputs/artifacts/vllm_report.json
!outputs/artifacts/vlm_blip_report.json
!outputs/artifacts/vlm_local_report.json
!outputs/artifacts/calibration_report.json
# scene_labels.json stays out: 1.1 MB of derived annotation summary, regenerated
# by scripts/dump_scene_labels.py in a few seconds.
!outputs/artifacts/trajlm_retrained_report.json
!outputs/artifacts/kernel_bench_report.json
!outputs/artifacts/cpp_report.json

# integrity monitor parity case: 1.4 MB binary, regenerated by scripts/dump_integrity_case.py
cpp/integrity_case.bin
cpp/build*/
.tmp/
!outputs/artifacts/device_report.json
outputs/viz

# Observability line of work (A12-A28). Same rule as above: name every file, so
# a new artifact is a deliberate commit and never an accident. CI gates these,
# and a gate cannot run on a file that was never committed -- which is exactly
# what happened between A20 and A28 and is what this block fixes.
!outputs/artifacts/h2_max.json
!outputs/artifacts/h2_ray_full.json
!outputs/artifacts/killgate_max_nonfree.json
!outputs/artifacts/surf_zero_verdict.json
!outputs/artifacts/camera_dropout.json
